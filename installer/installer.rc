// Icon (tools\make_installer_icon.ps1) and file properties of RisenModsInstaller.exe.
#include <windows.h>
#include "version.h"

1 ICON "installer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION INSTALLER_VERSION_NUMBERS
PRODUCTVERSION INSTALLER_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LOTARLMEN"
            VALUE "FileDescription", "Risen Mods installer"
            VALUE "FileVersion", INSTALLER_VERSION
            VALUE "InternalName", "RisenModsInstaller"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "RisenModsInstaller.exe"
            VALUE "ProductName", "Risen Mods"
            VALUE "ProductVersion", INSTALLER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
